# 复制成 .env 再改。真正的 .env 和 .env.prod 不要提交。
# 每一项的意思见 docs/deploy-official.md 的「配置」一节。

# 让机器人同时读 .env.prod，QQ_BOTS 写在那里。不要删。
ENVIRONMENT=prod
DRIVER=~fastapi+~httpx+~websockets
QQ_API_BASE=https://api.bot.qq.com/
LOG_LEVEL=INFO
COMMAND_START=["/"]

# QQ 官方机器人的 AppID、Token、AppSecret 和事件订阅。把下面这一行去掉注释，写进 .env.prod，换成你的值：
# QQ_BOTS='[{"id": "your-appid", "token": "your-token", "secret": "your-appsecret", "intent": {"guilds": false, "guild_members": false, "guild_message_reactions": false, "message_audit": false, "at_messages": false, "c2c_group_at_messages": true}}]'

# 管理员的编号。平台不给 QQ 号，这里填桥接层给你分的编号（从 90 亿起），第一次启动后才知道，见部署步骤第 6 步。
# 号码要加引号，例如 ["123456789"]。
SUPERUSERS=[]

# 机器人总会在这里开一个 OneBot v11 的 WebSocket 入口。只听本机，再设一串随机字符，别人就连不上。
HOST=127.0.0.1
PORT=8080
ONEBOT_ACCESS_TOKEN=change-me-to-a-long-random-string

# 插件的数据放在 bot.py 旁边的 ./data、./cache、./config 里。
LOCALSTORE_USE_CWD=true

# 定时任务按北京时间运行。机器人正忙时错过的任务会补跑：夜间签到 15 分钟内，榜单统计一小时内，不会拖到第二天。
APSCHEDULER_CONFIG='{"apscheduler.timezone": "Asia/Shanghai", "apscheduler.job_defaults.misfire_grace_time": 900, "apscheduler.job_defaults.coalesce": true}'

# 帮助图（/skl帮助）里「@机器人」处显示的名字，默认「机器人」：
# HELP_BOT_NAME=Priestess

# 群里的 @ 用真正的 @：能点，对方有提醒。带 @ 的文字改用 markdown 发，需要机器人有 markdown 权限：
# OFFICIAL_BRIDGE_MENTION_MARKUP=true

# 搭配 nonebot-bison：桥接层以机器人的身份连到 Bison 的 OneBot v11 地址，帮助图里列出 Bison 的订阅指令。
# Bison 自己的 SUPERUSERS 填和上面 SUPERUSERS 一样的号码。
# OFFICIAL_BRIDGE_ONEBOT_CLIENTS=[{"url": "ws://127.0.0.1:8081/onebot/v11/ws", "access_token": "change-me"}]
# HELP_BISON=true

# ---------------------------------------------------------------------------
# 只在从 NapCat 版迁移时用，见 docs/migrate-to-official.md。
# 帮助图提示老用户加机器人为好友、私聊发 /skl绑定 扫一次码：
# HELP_MIGRATION_NOTE=true
# 下面三项只在 NapCat 账号和官方机器人一起跑时用。
# 定时推送由官方机器人发出。并存期间一定要设，NapCat 账号这时不再主动发消息：
# OFFICIAL_BRIDGE_PRIMARY=true
# 官方机器人资料卡上的 QQ 号，原机器人靠它认出进群的是官方机器人：
# OFFICIAL_BRIDGE_UINS=["123456789"]
# 没对上原群号的群里，不带 @ 的指令也由官方机器人回答，默认只回答真正 @ 它的：
# OFFICIAL_BRIDGE_SHADOW_UNLINKED=false
